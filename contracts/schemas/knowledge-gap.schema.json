{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer knowledge gap",
  "type": "object",
  "required": ["gap_id", "run_id", "message_id", "purpose", "question", "reason", "created_at"],
  "properties": {
    "gap_id": {"type": "string"},
    "run_id": {"type": "string"},
    "message_id": {"type": "string"},
    "purpose": {"type": "string", "enum": ["person", "game_info", "game_guide", "game_item"]},
    "question": {"type": "string"},
    "reason": {"type": "string"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
